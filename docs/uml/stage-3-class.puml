  + chooseItem(menu : MenuItem[]) : MenuItem
  + getWaitingLoss() : int
  + getDiscountRate() : double
  + getCustomerType() : String
  + seat() : void
  + placeOrder(order : Order) : void
  + markServed() : void
  + finishEating() : void
  + markPaid() : void
  + leave() : void
  + loseWaitingSatisfaction() : void
  + hasLeft() : boolean
  + recoverHappyHourSatisfaction() : void
