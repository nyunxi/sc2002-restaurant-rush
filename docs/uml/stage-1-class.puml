@startuml
skinparam classAttributeIconSize 0
hide empty members

class Table <<entity>> {
  - tableId : int {readOnly}
  + isFree() : boolean
  + seat(c : Customer) : ActionResult
  + free() : void
}

enum CustomerState <<enumeration>> {
  WAITING
  SEATED
}

Table "0..1" --> "0..1" Customer : seated >

note right of Customer
  Encapsulation: ...
end note
@enduml